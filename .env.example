# Copy this file to .env.local and fill in your Supabase project values.
# (Supabase dashboard → Project Settings → API)

# Public project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Public anon (publishable) key — safe to use in the frontend (protected by RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# NEVER put the service_role key here — it must stay server-side only.

# ── Gemini AI (AI Chat uchun) ───────────────────────────────────────────
# Google AI Studio dan olingan bepul API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ── Admin panel ──────────────────────────────────────────────────────────
# Admin panelga parol bilan kirish paroli (serverda tekshiriladi).
# Buni Convex dashboard → Settings → Environment Variables bo'limiga qo'shing
# (convex env set ADMIN_PASSWORD sizning_parolingiz), .env.local ga EMAS —
# aks holda frontend bundle ichida ko'rinib qoladi.
# ADMIN_PASSWORD=
