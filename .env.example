[TEMPLATE]
# Copy this file to .env.local and fill in your Convex project values.
# (Convex dashboard → Settings yoki `npx convex deploy` dan keyin)

# Convex deployment URL — masalan https://xxxx-xxxx-xxx.convex.cloud
NEXT_PUBLIC_CONVEX_URL=

# Convex site URL (HTTP action'lar uchun) — masalan https://xxxx-xxxx-xxx.convex.site
NEXT_PUBLIC_CONVEX_SITE_URL=

# ── Admin panel ──────────────────────────────────────────────────────────
# Admin panelga parol bilan kirish paroli (serverda tekshiriladi).
# Buni Convex dashboard → Settings → Environment Variables bo'limiga qo'shing
# (npx convex env set ADMIN_PASSWORD sizning_parolingiz), .env.local ga EMAS —
# aks holda frontend bundle ichida ko'rinib qoladi.
# ADMIN_PASSWORD=
